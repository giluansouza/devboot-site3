# Generate a private token, for example: openssl rand -hex 32
BLOG_API_TOKEN=
BLOG_BASE_URL=https://www.devboot.com.br
# Enable only after deciding that scheduled tasks may publish directly.
BLOG_ALLOW_AUTO_PUBLISH=false
# MCP uses OAuth, not the API token above. Configure an OAuth 2.1 provider
# with authorization-code + PKCE (S256), refresh tokens and scope blog:write.
# The audience/resource registered at the provider must be BASE_URL/mcp.
BLOG_OAUTH_ISSUER=
BLOG_OAUTH_JWKS_URL=
# Local stdio MCP only: supplied/exported history and target preview.
BLOG_LOCAL_URL=http://127.0.0.1:18973
# Set an absolute directory path; omitted defaults to .local/history in this repo.
BLOG_HISTORY_DIR=

#!/usr/bin/env bash
# pre-push — installed by the factory. Edit `.githooks/config`, not this file.
#
# Push is the operation with no undo, so what runs here is only what becomes permanent
# the moment it lands. Everything else — a weak test, an oversized class, a missing
# migration — is reversible tomorrow and belongs to a different moment.
#
#   push safety   history loss and permanent blobs
#   secrets       a credential is rotated after a push, never deleted
#   size          the file-size ratchet, over what this branch changed
#   red-green     only where the project declared how to run its tests
#
# WHAT IS DELIBERATELY NOT HERE
#   The full suite, mutation testing, and anything needing a container or the network.
#   A slow hook is a bypassed hook: this park already runs its release script with
#   --skip-gates every single time because four gates there are permanently red.
#
# To bypass in a genuine emergency: `git push --no-verify`. Deliberate and visible; the
# alternative is someone disabling the hook for good.
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO}"
# git passes the remote being pushed to; its default branch holds the accepted secrets list.
REMOTE="${1:-origin}"

FOUNDATION="${FOUNDATION_HOME:-${HOME}/dev/foundation}"

# Project-owned and never overwritten by the factory. The procedure is universal; every
# answer it needs is local.
MAX_BLOB_MB="10"
TEST_CMD=""
TEST_DIR=""
# shellcheck source=/dev/null
[[ -f .githooks/config ]] && source .githooks/config

FAILED=(); UNVERIFIED=()

GATE_LOG="${FOUNDATION}/tools/gate-log"
log() { [[ -x "${GATE_LOG}" ]] && "${GATE_LOG}" "$@" >/dev/null 2>&1; true; }

gate() {  # gate <name> <command...>
  local name="$1"; shift
  local out rc=0 t0 ms
  t0=$(date +%s%3N)
  out="$("$@" 2>&1)" || rc=$?
  ms=$(( $(date +%s%3N) - t0 ))
  log record "${name}" "${rc}" "${ms}"
  # 2 and 3 both mean "could not answer". They are counted, never rounded to a pass —
  # a ✅ over a gate that verified nothing is the exact lie this standard exists to stop.
  if [[ ${rc} -eq 2 || ${rc} -eq 3 ]]; then
    printf '  ⏭️  %-16s %s\n' "${name}" "$(head -1 <<<"${out}" | cut -c1-72)"
    UNVERIFIED+=("${name}")
    return 0
  fi
  if [[ ${rc} -ne 0 ]]; then
    printf '  ❌ %-16s\n' "${name}"
    sed 's/^/       /' <<<"${out}"
    FAILED+=("${name}")
    return 0
  fi
  printf '  ✅ %-16s %s\n' "${name}" "$(tail -1 <<<"${out}" | cut -c1-72)"
}

if [[ ! -d "${FOUNDATION}/tools" ]]; then
  echo "⏭️  pre-push: the factory is not at ${FOUNDATION} — nothing was verified."
  echo "   Set FOUNDATION_HOME, or push with --no-verify if this clone is elsewhere."
  exit 0
fi

# git's pre-push protocol, readable once. The timeout is for every other way this file
# gets run — by hand, from an agent's shell — where stdin never closes and `cat` hangs.
REFS=""
[[ -t 0 ]] || REFS="$(timeout 2 cat || true)"

push_safety() { printf '%s\n' "${REFS}" | "${FOUNDATION}/tools/check-push" \
                  --repo "${REPO}" --max-blob-mb "${MAX_BLOB_MB}"; }

# Only what this branch changed, and only against the baseline — a large file that did
# not grow is not this push's problem, and saying otherwise makes the gate red forever.
size_ratchet() {
  local base rc=0 f
  base="$(git rev-parse --verify --quiet origin/HEAD || git rev-parse --verify --quiet origin/master)" || true
  [[ -z "${base}" ]] && { echo "no remote default branch to compare against"; return 3; }
  [[ -x "${FOUNDATION}/tools/size-ratchet" ]] || { echo "size-ratchet not found"; return 3; }
  while IFS= read -r f; do
    [[ -f "${f}" ]] || continue
    "${FOUNDATION}/tools/size-ratchet" check "${f}" || rc=1
  done < <(git diff --name-only "${base}...HEAD" -- '*.php' 2>/dev/null)
  [[ ${rc} -eq 0 ]] && echo "changed files are within budget"
  return ${rc}
}

echo "🔒 pre-push gates"
gate "push safety"  push_safety
# What this push sends, not every local ref: an archive branch kept after a history
# reset is not being published. Run by hand (no stdin), it scans everything.
secrets() {
  if [[ -n "${REFS}" ]]; then
    printf '%s\n' "${REFS}" | "${FOUNDATION}/tools/check-secrets" "${REPO}" --pushed --ledger --remote "${REMOTE}"
  else
    "${FOUNDATION}/tools/check-secrets" "${REPO}" --ledger --remote "${REMOTE}"
  fi
}
gate "secrets"      secrets
gate "size"         size_ratchet

# Installed only where the project said how to run its tests. Everywhere else it would
# answer `unknown` on every single push, and a gate that always says unknown is
# decoration — which teaches people to skim past the ones that mean something.
if [[ -n "${TEST_CMD}" ]]; then
  RG_ARGS=(--cmd "${TEST_CMD}")
  [[ -n "${TEST_DIR}" ]] && RG_ARGS+=(--tests "${TEST_DIR}")
  gate "red-green"  "${FOUNDATION}/tools/check-red-green" "${REPO}" "${RG_ARGS[@]}"
fi

echo
if [[ ${#FAILED[@]} -gt 0 ]]; then
  echo "🚫 push blocked by ${#FAILED[@]} gate(s): ${FAILED[*]}"
  echo "   Fix, or bypass deliberately with:  git push --no-verify"
  exit 1
fi
if [[ ${#UNVERIFIED[@]} -gt 0 ]]; then
  echo "⚠️  ${#UNVERIFIED[@]} gate(s) could NOT run: ${UNVERIFIED[*]}"
  echo "   Nothing is blocking, and nothing checked them either. Not the same as passing."
fi
echo "✅ ${#FAILED[@]} blocked · $(( ${#UNVERIFIED[@]} )) unverified"
